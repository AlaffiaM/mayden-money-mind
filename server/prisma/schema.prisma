// Prisma schema for Money & Mind — PostgreSQL database (Render)
// Models: User, Subscription, Payment, Setting, Episode, ListenLog, Notification, NotificationRead

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// Registered users — both subscribers and admins
model User {
  id              Int              @id @default(autoincrement())
  fullName        String
  email           String?          @unique
  phone           String?          @unique
  passwordHash    String
  role            String           @default("user") // user | admin
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  resetPasswordToken    String?  @unique // sha256 hash of a one-time password reset token
  resetPasswordExpires  DateTime? // expiry for the reset token (1 hour)
  emailVerified   DateTime? // set to the verification time once the email is confirmed (null = unverified)
  createdAt       DateTime         @default(now())
  subscriptions   Subscription[]
  payments        Payment[]
  listenLogs      ListenLog[]
  notificationReads NotificationRead[]
  verificationTokens VerificationToken[]
}

// One-time email verification tokens — only the sha256 hash is stored. Single-use
// via usedAt, expiry via expiresAt. type currently "email" (reserved for future use).
model VerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("email") // email
  tokenHash String   @unique // sha256 hash of the raw token — raw token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, type])
}

// Subscription lifecycle: pending → active → past_due → cancelled/expired
model Subscription {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  plan      String    // weekly | monthly
  status      String    @default("pending") // pending | active | past_due | paused | cancelled | expired
  startDate   DateTime  @default(now())
  nextRenewal DateTime
  pausedAt    DateTime?  // set when paused to freeze the renewal timer
  autoRenew   Boolean   @default(true)
  paystackSubscriptionCode String? // Paystack subscription code for recurring card billing
  paystackPlanCode         String? // Paystack plan code (weekly or monthly) this sub belongs to
  payments    Payment[]
}

// Payment records — linked to subscriptions, tracks Paystack transactions
model Payment {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  subscriptionId Int
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  amount         Float
  currency       String        @default("NGN")
  status         String        // pending | success | failed
  reference      String        @unique
  last4          String?       // last 4 digits of the card charged (auto-renewal display)
  usesCard       Boolean       @default(true) // true = card (recurring), false = bank transfer/USSD/QR (one-time)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
}

// Key-value settings store — prices, grace period, notification config, day labels
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Daily audio episodes — published on a weekly schedule by day type
model Episode {
  id             String      @id @default(uuid())
  title          String
  dayType        String      // monday | tuesday | wednesday | thursday | friday
  audioUrl       String?
  runTimeSeconds Int         // seconds
  showNotes      String      // rich text HTML
  publishDate    DateTime
  status         String      @default("draft") // draft | scheduled | published
  listenCount    Int         @default(0)
  createdAt      DateTime    @default(now())
  listenLogs     ListenLog[]

  // One episode per day per week. This makes a duplicate insert fail loudly
  // (instead of silently creating a second row for the same weekday) and is the
  // root-cause guard against the duplicate episodes that came from double-running
  // the admin batch scheduler.
  @@unique([dayType, publishDate])
}

// Tracks a user's personal listening history. Doubles as the user's Library:
// one row per (user, episode) — the first time they listend (createdAt) and the
// most recent time (lastListenedAt). A unique constraint prevents duplicates
// when the same user listens to the same episode repeatedly.
model ListenLog {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  episodeId      String
  episode        Episode  @relation(fields: [episodeId], references: [id])
  createdAt      DateTime @default(now())
  lastListenedAt DateTime @updatedAt

  @@unique([userId, episodeId])
}

// In-app notifications — sent by admin or system events
model Notification {
  id              Int                @id @default(autoincrement())
  title           String
  body            String
  channels        String             // comma-separated: inapp,email
  sentBy          String             @default("admin")
  subscribersOnly Boolean            @default(false) // only visible to users with an active subscription
  sentAt          DateTime           @default(now())
  reads           NotificationRead[]
}

// Tracks which notifications each user has read — for unread badge count
model NotificationRead {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([userId, notificationId])
}




generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



model User {
  id              Int              @id @default(autoincrement())
  fullName        String
  email           String?          @unique
  phone           String?          @unique
  passwordHash    String
  role            String           @default("user")
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  resetPasswordToken    String?  @unique
  resetPasswordExpires  DateTime?
  emailVerified   DateTime?
  createdAt       DateTime         @default(now())
  subscriptions   Subscription[]
  payments        Payment[]
  listenLogs      ListenLog[]
  notificationReads NotificationRead[]
  verificationTokens VerificationToken[]
}



model VerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("email")
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, type])
}


model Subscription {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  plan      String
  status      String    @default("pending")
  startDate   DateTime  @default(now())
  nextRenewal DateTime
  pausedAt    DateTime?
  autoRenew   Boolean   @default(true)
  paystackSubscriptionCode String?
  paystackPlanCode         String?
  payments    Payment[]
}


model Payment {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  subscriptionId Int
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  amount         Float
  currency       String        @default("NGN")
  status         String
  reference      String        @unique
  last4          String?
  usesCard       Boolean       @default(true)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
}


model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}


model Episode {
  id             String      @id @default(uuid())
  title          String
  dayType        String
  audioUrl       String?
  runTimeSeconds Int
  showNotes      String
  publishDate    DateTime
  status         String      @default("draft")
  listenCount    Int         @default(0)
  createdAt      DateTime    @default(now())
  listenLogs     ListenLog[]





  @@unique([dayType, publishDate])
}





model ListenLog {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  episodeId      String
  episode        Episode  @relation(fields: [episodeId], references: [id])
  createdAt      DateTime @default(now())
  lastListenedAt DateTime @updatedAt

  @@unique([userId, episodeId])
}


model Notification {
  id              Int                @id @default(autoincrement())
  title           String
  body            String
  channels        String
  sentBy          String             @default("admin")
  subscribersOnly Boolean            @default(false)
  sentAt          DateTime           @default(now())
  reads           NotificationRead[]
}


model NotificationRead {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([userId, notificationId])
}
